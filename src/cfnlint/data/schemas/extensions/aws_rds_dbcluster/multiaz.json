{
 "if": {
  "properties": {
   "Engine": {
    "enum": [
     "mysql",
     "postgres"
    ],
    "type": "string"
   }
  },
  "required": [
   "Engine"
  ]
 },
 "then": {
  "allOf": [
   {
    "if": {
     "properties": {
      "StorageType": {
       "enum": [
        "io1",
        "io2"
       ]
      }
     },
     "required": [
      "StorageType"
     ],
     "type": "object"
    },
    "then": {
     "required": [
      "Iops"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "StorageType": false
     },
     "type": "object"
    },
    "then": {
     "required": [
      "Iops"
     ]
    }
   }
  ],
  "else": {
   "required": [
    "AllocatedStorage"
   ]
  },
  "if": {
   "required": [
    "ReplicationSourceIdentifier"
   ]
  },
  "properties": {
   "AvailabilityZones": false,
   "BacktrackWindow": false,
   "Domain": false,
   "DomainIAMRoleName": false,
   "EnableGlobalWriteForwarding": false,
   "EnableHttpEndpoint": false,
   "EnableIAMDatabaseAuthentication": false,
   "EngineMode": false,
   "GlobalClusterIdentifier": false,
   "NetworkType": false,
   "ScalingConfiguration": false,
   "ServerlessV2ScalingConfiguration": false,
   "SourceRegion": false,
   "StorageType": {
    "if": {
     "type": "string"
    },
    "then": {
     "enum": [
      "io1",
      "io2",
      "gp3"
     ]
    }
   }
  },
  "required": [
   "DBClusterInstanceClass"
  ],
  "then": {
   "properties": {
    "AllocatedStorage": false
   }
  }
 }
}
