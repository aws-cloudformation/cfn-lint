{
 "if": {
  "properties": {
   "AccessControl": {
    "not": {
     "enum": [
      "Private",
      "BucketOwnerFullControl",
      "BucketOwnerRead"
     ]
    },
    "type": "string"
   }
  },
  "required": [
   "AccessControl"
  ]
 },
 "then": {
  "properties": {
   "OwnershipControls": {
    "properties": {
     "Rules": {
      "contains": {
       "properties": {
        "ObjectOwnership": {
         "enum": [
          "ObjectWriter",
          "BucketOwnerPreferred"
         ]
        }
       },
       "required": [
        "ObjectOwnership"
       ]
      },
      "minItems": 1
     }
    },
    "required": [
     "Rules"
    ]
   }
  },
  "required": [
   "OwnershipControls"
  ]
 }
}
