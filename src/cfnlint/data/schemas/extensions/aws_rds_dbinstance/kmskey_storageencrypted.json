{
 "if": {
  "allOf": [
   {
    "properties": {
     "Engine": {
      "pattern": "^(?!custom-).*$",
      "type": "string"
     }
    },
    "required": [
     "KmsKeyId",
     "Engine"
    ],
    "type": "object"
   },
   {
    "not": {
     "anyOf": [
      {
       "required": [
        "SourceDBInstanceIdentifier"
       ]
      },
      {
       "required": [
        "SourceDbiResourceId"
       ]
      }
     ]
    }
   }
  ]
 },
 "then": {
  "properties": {
   "StorageEncrypted": {
    "enum": [
     "true",
     "True",
     true
    ]
   }
  },
  "required": [
   "StorageEncrypted"
  ]
 }
}
